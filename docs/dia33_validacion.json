    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (typeof $json.cliente !== \"string\") {\n    return {\n        json: {\n            ok: false,\n            error: \"El campo cliente falta o no es texto\"\n        }\n    };\n}\n\nif (typeof $json.servicio !== \"string\") {\n    return {\n        json: {\n            ok: false,\n            error: \"El campo servicio falta o no es texto\"\n        }\n    };\n}\n\nconst cliente = $json.cliente.trim().replace(/\\s+/g, \" \");\nconst servicio = $json.servicio.trim().toLowerCase();\n\nif (cliente === \"\") {\n    return {\n        json: {\n            ok: false,\n            error: \"El campo cliente está vacío\"\n        }\n    };\n}\n\nif (servicio === \"\") {\n    return {\n        json: {\n            ok: false,\n            error: \"El campo servicio está vacío\"\n        }\n    };\n}\n\nconst mensaje = \"Solicitud de \" + cliente + \" para \" + servicio;\n\nreturn {\n    json: {\n        ok: true,\n        cliente: cliente,\n        servicio: servicio,\n        mensaje: mensaje\n    }\n};"
      },
